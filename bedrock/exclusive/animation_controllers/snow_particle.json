{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.snow_particle": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry":[
          	"variable.life_time = query.life_time;"
          ],
          "transitions": [
            {
              "start_snowing": "(query.life_time - variable.life_time) >= 1.0"
            }
          ]
        },
        "start_snowing": {
          "particle_effects": [
            {
              "effect": "snow"
            }
          ],
          "transitions": [
            {
              "default": "1.0"
            }
          ]
        }
      }
    }
  }
}